{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "UCMR: Uncharted Collection Multiplayer Resurrected",
  "repo": "UC-Resurrected/UCMR",
  "start": {
    "program": ["UCMR_Launcher.exe", "UCMR_Launcher"]
  },
  "folders": {
    "saves": ["{install}/analysis/uncharted-user/savedata"],
    "logs": ["{install}/analysis"]
  },
  "saves": ["{install}/analysis/uncharted-user/savedata"],
  "actions": [
    {
      "id": "saves",
      "label": "Open the save folder",
      "open": "saves"
    },
    {
      "id": "logs",
      "label": "Open the log folder",
      "open": "logs"
    }
  ],
  "system": {
    "windows": {
      "version": "10",
      "graphics": { "vulkan": "1.3" }
    },
    "linux": {
      "glibc": "2.38",
      "graphics": { "vulkan": "1.3" }
    }
  }
}
