# ucmr.cmake - the CMake builds' side of tools/winres (the shell builds use winres.sh): gives a program or DLL the
# version information from tools/VERSION, the manifest and an optional icon (tools/winres/ucmr.rc.in).
#   ucmr_winres(<target> <file description> [ICON <id> <file>] [MANIFEST <file> | NO_MANIFEST] [COPYRIGHT <text>])
# MANIFEST replaces tools/winres/ucmr.manifest with the target's own; NO_MANIFEST leaves the manifest to the linker
# (MSVC writes its own); COPYRIGHT replaces "GNU GPL v2 or later" for a file under another license.
set(UCMR_WINRES_DIR ${CMAKE_CURRENT_LIST_DIR})

function(ucmr_winres target description)
    cmake_parse_arguments(ARG "NO_MANIFEST" "MANIFEST;COPYRIGHT" "ICON" ${ARGN})
    set(UCMR_COPYRIGHT "GNU GPL v2 or later")
    if (ARG_COPYRIGHT)
        set(UCMR_COPYRIGHT "${ARG_COPYRIGHT}")
    endif()
    file(STRINGS ${UCMR_WINRES_DIR}/../VERSION UCMR_VERSION LIMIT_COUNT 1)
    if (NOT UCMR_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
        message(FATAL_ERROR "tools/VERSION is not x.y.z: ${UCMR_VERSION}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        ${UCMR_WINRES_DIR}/../VERSION ${UCMR_WINRES_DIR}/ucmr.rc.in)
    string(REPLACE "." "," UCMR_VERSION_COMMA "${UCMR_VERSION},0")

    get_target_property(type ${target} TYPE)
    get_target_property(name ${target} OUTPUT_NAME)
    if (NOT name)
        set(name ${target})
    endif()
    set(UCMR_INTERNAL_NAME ${name})
    if (type STREQUAL SHARED_LIBRARY)
        set(UCMR_FILENAME ${CMAKE_SHARED_LIBRARY_PREFIX}${name}${CMAKE_SHARED_LIBRARY_SUFFIX})
        set(UCMR_FILETYPE VFT_DLL)
        set(manifest_id 2)
    else()
        set(UCMR_FILENAME ${name}${CMAKE_EXECUTABLE_SUFFIX})
        set(UCMR_FILETYPE VFT_APP)
        set(manifest_id 1)
    endif()
    set(UCMR_DESCRIPTION "${description}")

    set(UCMR_ICON_LINE "")
    set(deps "")   # the manifest and the icon are read by the resource compiler, not by CMake
    if (ARG_ICON)
        list(GET ARG_ICON 0 icon_id)
        list(GET ARG_ICON 1 icon_file)
        get_filename_component(icon_file "${icon_file}" ABSOLUTE)
        set(UCMR_ICON_LINE "${icon_id} ICON \"${icon_file}\"")
        list(APPEND deps ${icon_file})
    endif()
    set(UCMR_MANIFEST_LINE "")
    if (NOT ARG_NO_MANIFEST)
        set(manifest ${UCMR_WINRES_DIR}/ucmr.manifest)
        if (ARG_MANIFEST)
            get_filename_component(manifest "${ARG_MANIFEST}" ABSOLUTE)
        endif()
        set(UCMR_MANIFEST_LINE "${manifest_id} 24 \"${manifest}\"")
        list(APPEND deps ${manifest})
    endif()

    set(rc ${CMAKE_CURRENT_BINARY_DIR}/${target}_ucmr.rc)
    configure_file(${UCMR_WINRES_DIR}/ucmr.rc.in ${rc} @ONLY)
    target_sources(${target} PRIVATE ${rc})
    if (deps)
        set_source_files_properties(${rc} PROPERTIES OBJECT_DEPENDS "${deps}")   # rebuild the .rc when they change
    endif()
endfunction()
